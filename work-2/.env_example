# Copy this file to .env and fill in your real LLM API settings.
#
# The script works with OpenAI-compatible Chat Completions APIs.
# Examples of compatible gateways include OpenAI, OpenRouter, local proxies,
# and providers that expose /chat/completions with Bearer authentication.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER_NAME=openai-compatible

# Use json_schema when the provider supports structured outputs.
# If the provider rejects response_format, try json_object or prompt_only.
LLM_RESPONSE_FORMAT=json_schema
