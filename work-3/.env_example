# Copy this file to .env and fill in your real API settings.
#
# The app requires a Responses-compatible API with the code_interpreter tool.
# OpenAI project keys like sk-proj-... are the primary supported scenario.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_PROVIDER_NAME=openai

# Code Interpreter container memory: 1g, 4g, 16g, or 64g.
CODE_INTERPRETER_MEMORY=1g

# Streamlit upload limit handled by the app before sending to API.
MAX_UPLOAD_MB=20
